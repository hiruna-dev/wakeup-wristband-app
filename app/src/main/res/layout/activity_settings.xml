<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    tools:context=".SettingsActivity">

    <!-- ── Header ── -->
    <TextView
        android:id="@+id/tvSettingsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/title"
        android:gravity="center"
        android:text="Settings"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/tvSettingsTitle"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- ── Defaults Section ── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/colorAppCard"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/subtitle"
                        android:text="App Defaults"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:layout_marginBottom="16dp"/>

                    <!-- Default Location Radius -->
                    <TextView
                        android:id="@+id/tvDefaultRadiusLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Default Radius: 50m"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderDefaultRadius"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="20"
                        android:valueTo="500"
                        android:value="50"
                        android:stepSize="10"
                        app:thumbColor="?attr/colorAppPrimary"
                        app:trackColorActive="?attr/colorAppPrimary"
                        app:trackColorInactive="#D1D5DB"
                        android:layout_marginBottom="20dp" />

                    <!-- Default Vibration Intensity (custom segmented control) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Default Alarm Vibration"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:id="@+id/vibrationSegmentGroup"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:background="@drawable/shape_segment_outline"
                        android:clipChildren="true">

                        <TextView
                            android:id="@+id/defaultVibLow"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Low"
                            android:textColor="?attr/colorAppPrimary"
                            android:textSize="14sp"/>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="?attr/colorAppPrimary"
                            android:alpha="0.2"/>

                        <TextView
                            android:id="@+id/defaultVibMedium"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Medium"
                            android:textColor="?attr/colorAppPrimary"
                            android:textSize="14sp"/>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="?attr/colorAppPrimary"
                            android:alpha="0.2"/>

                        <TextView
                            android:id="@+id/defaultVibHigh"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="High"
                            android:textColor="?attr/colorAppPrimary"
                            android:textSize="14sp"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── Display & Theme Section ── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/colorAppCard"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/subtitle"
                        android:text="Theme"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="4"
                        android:layout_marginBottom="8dp">

                        <!-- Orange Theme Button -->
                        <LinearLayout
                            android:id="@+id/btnThemeOrange"
                            android:layout_width="0dp"
                            android:layout_height="70dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="3dp"
                            android:background="#FDEAEA"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:elevation="2dp">

                            <View
                                android:layout_width="24dp"
                                android:layout_height="12dp"
                                android:background="#F15A24"
                                android:layout_marginBottom="4dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Orange"
                                android:textSize="11sp"
                                android:textColor="#4A152A"
                                android:textStyle="bold"/>
                        </LinearLayout>

                        <!-- Teal Theme Button -->
                        <LinearLayout
                            android:id="@+id/btnThemeTeal"
                            android:layout_width="0dp"
                            android:layout_height="70dp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="3dp"
                            android:background="#CCFBF1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:elevation="2dp">

                            <View
                                android:layout_width="24dp"
                                android:layout_height="12dp"
                                android:background="#0D9488"
                                android:layout_marginBottom="4dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Teal"
                                android:textSize="11sp"
                                android:textColor="#134E4A"
                                android:textStyle="bold"/>
                        </LinearLayout>

                        <!-- Purple Theme Button -->
                        <LinearLayout
                            android:id="@+id/btnThemePurple"
                            android:layout_width="0dp"
                            android:layout_height="70dp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="3dp"
                            android:background="#F3E8FF"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:elevation="2dp">

                            <View
                                android:layout_width="24dp"
                                android:layout_height="12dp"
                                android:background="#7C3AED"
                                android:layout_marginBottom="4dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Purple"
                                android:textSize="11sp"
                                android:textColor="#4C1D95"
                                android:textStyle="bold"/>
                        </LinearLayout>

                        <!-- Blue Theme Button -->
                        <LinearLayout
                            android:id="@+id/btnThemeBlue"
                            android:layout_width="0dp"
                            android:layout_height="70dp"
                            android:layout_weight="1"
                            android:layout_marginStart="3dp"
                            android:background="#EFF6FF"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:elevation="2dp">

                            <View
                                android:layout_width="24dp"
                                android:layout_height="12dp"
                                android:background="#3B82F6"
                                android:layout_marginBottom="4dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Blue"
                                android:textSize="11sp"
                                android:textColor="#1E3A8A"
                                android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvThemeHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tap a theme to apply. The app will restart."
                        android:textColor="@color/text_tertiary"
                        android:textSize="11sp"
                        android:gravity="center"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── Data Section ── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/colorAppCard"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/subtitle"
                        android:text="Data"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:layout_marginBottom="12dp"/>

                    <Button
                        android:id="@+id/btnClearHistory"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Clear History"
                        android:textColor="@color/white"
                        android:backgroundTint="?attr/colorAppPrimary"
                        app:cornerRadius="26dp"
                        style="@style/Widget.MaterialComponents.Button" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Permanently deletes analytics heatmap data. Saved Locations and Alarms are unaffected."
                        android:textColor="@color/text_tertiary"
                        android:textSize="11sp"
                        android:layout_marginTop="8dp"
                        android:gravity="center" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ── Bottom Navigation Bar ── -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_bottom_nav"
        android:elevation="8dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout android:id="@+id/navHome" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_home" app:tint="@color/text_tertiary" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:text="Home"
                android:textColor="@color/text_tertiary" android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/navMap" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_map" app:tint="@color/text_tertiary" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:text="Map"
                android:textColor="@color/text_tertiary" android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/navAnalytics" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_chart" app:tint="@color/text_tertiary" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:text="Analytics"
                android:textColor="@color/text_tertiary" android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/navSettings" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center" android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_settings" app:tint="?attr/colorAppPrimary" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:text="Settings"
                android:textColor="?attr/colorAppPrimary" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
